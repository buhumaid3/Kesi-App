{
  "name": "kesi-app",
  "private": true,
  "version": "0.1.0",
  "description": "Kesi: Kenya Case Files — case data, validator and asset tools",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate.mjs www/cases",
    "prompts": "node tools/compile-prompts.mjs www/cases prompts",
    "contrast": "node tools/contrast.mjs",
