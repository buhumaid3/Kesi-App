{
  "name": "kesi-app",
  "private": true,
  "version": "0.1.0",
  "description": "Kesi: Kenya Case Files — case data, validator and asset tools",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate.mjs www/cases",
    "prompts": "node tools/compile-prompts.mjs www/cases prompts",
    "contrast": "node tools/contrast.mjs",
    "images": "node tools/generate-images.mjs",
    "play": "node tools/serve.mjs",
    "place": "node tools/serve.mjs --place",
    "test": "node tests/autoplay.mjs 1 100 && node tests/clock.mjs && node tests/travel.mjs && node tests/region7.mjs && node tests/region9.mjs && node tests/motion.mjs && node tests/music.mjs",
    "build": "node tools/build.mjs",
    "ios:sync": "node tools/build.mjs && npx cap sync ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#1A110C' --splashBackgroundColor '#1A110C' --splashBackgroundColorDark '#120C08'",
    "icon": "node tools/make-icon.mjs",
    "place:auto": "node tools/auto-place.mjs",
    "images:audit": "node tools/images-audit.mjs",
    "images:check": "node tools/images-audit.mjs --region 1 --gaps",
    "images:briefs": "node tools/apply-briefs.mjs",
    "test:images": "node tests/ui-images.mjs http://127.0.0.1:5173",
    "voices:loudness": "node tools/voice-loudness.mjs",
    "splash": "node tools/make-splash.mjs",
    "test:b8": "node tests/ui-b8.mjs http://127.0.0.1:5173",
    "test:b11": "node tests/ui-b11.mjs http://127.0.0.1:5173",
    "test:b12": "node tests/ui-b12.mjs http://127.0.0.1:5173",
    "test:b13": "node tests/ui-b13.mjs http://127.0.0.1:5173",
    "test:b14": "node tests/ui-b14.mjs http://127.0.0.1:5173",
    "test:b15": "node tests/ui-b15.mjs http://127.0.0.1:5173",
    "test:b16": "node tests/ui-b16.mjs http://127.0.0.1:5173",
    "test:paper": "node tests/ui-paper.mjs http://127.0.0.1:5173",
    "test:motion": "node tests/motion.mjs",
    "test:launch": "node tests/ui-launch.mjs",
    "music": "node tools/generate-music.mjs",
    "test:music": "node tests/music.mjs",
    "test:audio": "node tests/ui-audio.mjs",
    "test:motion-ui": "node tests/ui-motion.mjs",
    "recon:briefs": "node tools/recon-briefs.mjs",
    "test:pictures": "node tests/ui-pictures.mjs",
    "store:shots": "node tools/store-shots.mjs",
    "test:look": "node tests/ui-look.mjs",
    "test:tools": "node tests/ui-tools.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@google/genai": "2.32.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "playwright": "^1.64.1"
  }
}
